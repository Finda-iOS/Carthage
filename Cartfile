github "SnapKit/SnapKit" == "5.7.1"

# SwiftyJSON
# - 생성 xcframework: SwiftyJSON.xcframework
# - 역할: JSON 파싱 유틸리티 (subscript 기반 타입 안전 JSON 접근)
github "SwiftyJSON/SwiftyJSON" == "5.0.2"

# Swinject
# - 생성 xcframework: Swinject.xcframework
